{
    "name": "sourngseng/laravel-aba-payway",
    "description": "Laravel package for ABA PayWay payment gateway integration in Cambodia",
    "keywords": ["laravel", "aba", "payway", "payment", "gateway", "cambodia"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sourng Seng",
            "email": "sourngtech@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "SourngSeng\\AbaPayway\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SourngSeng\\AbaPayway\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SourngSeng\\AbaPayway\\AbaPaywayServiceProvider"
            ],
            "aliases": {
                "AbaPayway": "SourngSeng\\AbaPayway\\Facades\\AbaPayway"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}